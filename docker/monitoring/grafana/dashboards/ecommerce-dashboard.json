{
  "dashboard": {
    "id": null,
    "title": "E-commerce Backend Dashboard",
    "tags": ["ecommerce", "spring-boot", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count[5m])",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "max": true,
          "min": true,
          "avg": true
        }
      },
      {
        "id": 2,
        "title": "Response Time (99th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket[5m])))",
            "legendFormat": "99th percentile {{method}} {{uri}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket[5m])))",
            "legendFormat": "50th percentile {{method}} {{uri}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "E-commerce Metrics - Orders",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ecommerce_orders_total[5m])",
            "legendFormat": "Orders/sec",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Orders/sec",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "E-commerce Metrics - Product Views",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ecommerce_products_views[5m])",
            "legendFormat": "Product Views/sec",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Views/sec",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "E-commerce Metrics - User Registrations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ecommerce_users_registrations[5m])",
            "legendFormat": "Registrations/sec",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Registrations/sec",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "Authentication Failures",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ecommerce_auth_failures[5m])",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Failures/sec",
            "min": 0
          }
        ],
        "xAxes": [
          {
            "type": "time"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 7,
        "title": "Rate Limit Exceeded",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ecommerce_rate_limit_exceeded[5m])",
